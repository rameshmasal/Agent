<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:system-ap-ifor-postgres-db="http://www.mulesoft.org/schema/mule/system-ap-ifor-postgres-db"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/system-ap-ifor-postgres-db http://www.mulesoft.org/schema/mule/system-ap-ifor-postgres-db/current/mule-system-ap-ifor-postgres-db.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

	<flow name="rf-orderstatus-get">
		<logger level="INFO" doc:name="Flow started" message="#['Order status request for order id: ' ++ (vars.orderId default '')]"/>
		<!-- orderId and brand go into the System API filter as text, so only plain id characters are accepted -->
		<choice doc:name="validate-input">
			<when expression="#[not ((vars.orderId default '') matches /^[A-Za-z0-9_\-]{1,64}$/) or not ((vars.brand default '') matches /^[A-Za-z0-9_\-]{1,64}$/)]">
				<raise-error type="APP:BAD_REQUEST" description="orderId and brand must be 1 to 64 letters, digits, hyphens or underscores" doc:name="Raise bad request"/>
			</when>
		</choice>
		<try doc:name="Load order status">
			<system-ap-ifor-postgres-db:select-rows-from-a-specified-schema-and-table
				doc:name="select order status"
				config-ref="System_API_for_Postgres_DB_Config"
				schema-name='#[p("prc-orderstatus-api.database.schema-name")]'
				table-name='#[p("prc-orderstatus-api.database.table-name")]'
				filter="#[&quot;order_id.eq.'&quot; ++ vars.orderId ++ &quot;',,brand.eq.'&quot; ++ vars.brand ++ &quot;'&quot;]"
				client-id='#[p("secure::postgres-api.client-id")]'
				client-secret='#[p("secure::postgres-api.client-secret")]' />
			<error-handler>
				<on-error-continue type="SYSTEM-AP-IFOR-POSTGRES-DB:NOT_FOUND" logException="false" doc:name="No rows">
					<set-payload value="#[[]]" doc:name="Empty result"/>
				</on-error-continue>
			</error-handler>
		</try>
		<choice doc:name="check-record-found">
			<when expression="#[isEmpty(payload) or isEmpty(payload[0].order_snapshot)]">
				<ee:transform doc:name="create-not-found-response">
					<ee:message>
						<ee:set-payload resource="transformation/order-not-found.dwl" />
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">200</ee:set-variable>
					</ee:variables>
				</ee:transform>
				<logger level="INFO" doc:name="not found log" message="#['Order not found: ' ++ (vars.orderId default '')]"/>
			</when>
			<otherwise>
				<ee:transform doc:name="create-response">
					<ee:message>
						<ee:set-payload resource="transformation/order-status-response.dwl" />
					</ee:message>
					<ee:variables>
						<!-- evaluated against the DB row, before the payload is replaced by the snapshot -->
						<ee:set-variable variableName="orderStatus"><![CDATA[payload[0].order_status default ""]]></ee:set-variable>
						<ee:set-variable variableName="siteId"><![CDATA[payload[0].site_id default ""]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<async doc:name="Async">
					<flow-ref doc:name="sf-splunk-info" name="sf-splunk-info" />
				</async>
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="Process end" message="Process completed."/>
		<error-handler>
			<on-error-propagate type="APP:BAD_REQUEST" enableNotifications="true" logException="false" doc:name="Bad request">
				<ee:transform doc:name="create-bad-request-response">
					<ee:message>
						<ee:set-payload resource="transformation/bad-request-response.dwl" />
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">400</ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
			<on-error-propagate when="#[error.errorType.namespace == 'SYSTEM-AP-IFOR-POSTGRES-DB' or error.errorType.namespace == 'HTTP' or error.errorType.identifier == 'CONNECTIVITY' or error.errorType.identifier == 'TIMEOUT']" enableNotifications="true" logException="true" doc:name="Backend unavailable">
				<logger level="ERROR" doc:name="log error" message="Postgres System API failure : #[error.detailedDescription]"/>
				<async doc:name="Async">
					<flow-ref doc:name="sf-splunk-error" name="sf-splunk-error"/>
				</async>
				<ee:transform doc:name="create-service-unavailable-response">
					<ee:message>
						<ee:set-payload resource="transformation/service-unavailable-response.dwl" />
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">503</ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate">
				<logger level="ERROR" doc:name="log error" message="Error in processing : #[error.detailedDescription]"/>
				<async doc:name="Async">
					<flow-ref doc:name="sf-splunk-error" name="sf-splunk-error"/>
				</async>
				<ee:transform doc:name="create-error-response">
					<ee:message>
						<ee:set-payload resource="transformation/error-response.dwl" />
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">500</ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
		</error-handler>
	</flow>

	<sub-flow name="sf-splunk-info">
		<ee:transform doc:name="create-splunk-request">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="log_cust_att"><![CDATA[%dw 2.0
output application/json
---
{
	"order-id" : vars.orderId default "",
	"order-status" : payload.orderStatus default "",
	"brand" : payload.brand default "",
	"site-id" : payload.siteId default ""
}]]></ee:set-variable>
				<ee:set-variable variableName="SplunkMessage"><![CDATA["Order status API for order " ++ (vars.orderId default "")]]></ee:set-variable>
				<ee:set-variable variableName="Status"><![CDATA["success"]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="sf-splunk-sub-flow" name="sf-splunk-sub-flow"/>
	</sub-flow>

	<sub-flow name="sf-splunk-error">
		<ee:transform doc:name="create-splunk-request">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="SplunkMessage"><![CDATA["Error in Order status API for order " ++ (vars.orderId default "") ++ ". Error : " ++ (error.description default "")]]></ee:set-variable>
				<ee:set-variable variableName="log_cust_att"><![CDATA[%dw 2.0
output application/json
---
{
	"order-id" : vars.orderId default ""
}]]></ee:set-variable>
				<ee:set-variable variableName="Status"><![CDATA["Error"]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="sf-splunk-sub-flow" name="sf-splunk-sub-flow"/>
	</sub-flow>
</mule>
