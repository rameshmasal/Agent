<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
            http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
            http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit
            http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/ee/core
            http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <http:listener-config name="httpListenerConfig" doc:name="HTTP Listener Config">
        <http:listener-connection host="0.0.0.0" port="${sys-firstdata.http-listener.port}"/>
    </http:listener-config>

    <apikit:config
        name="sys-firstdata-api-v1-config"
        api="api/sys-firstdata-api-v1.raml"
        outboundHeadersMapName="outboundHeaders"
        httpStatusVarName="httpStatus"
        doc:name="APIKit Config"/>

    <!-- ─── Main listener flow ─── -->
    <flow name="sys-firstdata-api-v1-main" doc:name="sys-firstdata-api-v1-main">
        <http:listener
            config-ref="httpListenerConfig"
            path="${sys-firstdata.http-listener.path}"
            doc:name="HTTP Listener">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="sys-firstdata-api-v1-config" doc:name="APIKit Router"/>
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST" enableNotifications="true" logException="true">
                <ee:transform doc:name="400 Bad Request">
                    <ee:message>
                        <ee:set-payload resource="transformdata/400error.dwl"/>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND" enableNotifications="true" logException="true">
                <ee:transform doc:name="404 Not Found">
                    <ee:message>
                        <ee:set-payload resource="transformdata/404-error.dwl"/>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[404]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform doc:name="405 Method Not Allowed">
                    <ee:message>
                        <ee:set-payload resource="transformdata/405-error.dwl"/>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[405]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform doc:name="406 Not Acceptable">
                    <ee:message>
                        <ee:set-payload resource="transformdata/406-error.dwl"/>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[406]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform doc:name="415 Unsupported Media Type">
                    <ee:message>
                        <ee:set-payload resource="transformdata/415-error.dwl"/>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[415]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform doc:name="501 Not Implemented">
                    <ee:message>
                        <ee:set-payload resource="transformdata/501-error.dwl"/>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[501]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APP:INVALID_BRAND" enableNotifications="true" logException="true">
                <ee:transform doc:name="400 Invalid Brand">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "error": {
        "code":    "400",
        "status":  "INVALID_BRAND",
        "message": error.description default "Brand header is missing or not whitelisted"
    }
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APP:BRAND_CONFIG_NOT_FOUND" enableNotifications="true" logException="true">
                <ee:transform doc:name="400 Brand Config Not Found">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "error": {
        "code":    "400",
        "status":  "BRAND_CONFIG_NOT_FOUND",
        "message": error.description default "No configuration found for the given brand"
    }
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="HTTP:CONNECTIVITY,HTTP:TIMEOUT" enableNotifications="true" logException="true">
                <ee:transform doc:name="503 Service Unavailable">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "error": {
        "code":    "503",
        "status":  "SERVICE_UNAVAILABLE",
        "message": error.description default "First Data endpoint is unreachable"
    }
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[503]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APP:ERROR" enableNotifications="true" logException="true">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
vars.app_error]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="ANY">
                <ee:transform doc:name="500 Internal Server Error">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "error": {
        "code":    "500",
        "status":  "INTERNAL_ERROR",
        "message": error.description default "An unexpected error occurred"
    }
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[500]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>

    <!-- ─── API Console ─── -->
    <flow name="sys-firstdata-api-v1-console" doc:name="sys-firstdata-api-v1-console">
        <http:listener config-ref="httpListenerConfig" path="/console/*" doc:name="HTTP Listener Console">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="sys-firstdata-api-v1-config" doc:name="APIKit Console"/>
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>

    <!-- ── Dispatcher flows — one per RAML operation ──────────────────── -->

    <flow name="post:\balance:application/json:sys-firstdata-api-v1-config"
          doc:name="post:/balance dispatch">
        <flow-ref name="rf-firstdata-balance-post" doc:name="rf-firstdata-balance-post"/>
    </flow>

    <flow name="post:\activate:application/json:sys-firstdata-api-v1-config"
          doc:name="post:/activate dispatch">
        <flow-ref name="rf-firstdata-activate-post" doc:name="rf-firstdata-activate-post"/>
    </flow>

    <flow name="post:\lock:application/json:sys-firstdata-api-v1-config"
          doc:name="post:/lock dispatch">
        <flow-ref name="rf-firstdata-lock-post" doc:name="rf-firstdata-lock-post"/>
    </flow>

    <flow name="post:\unlock:application/json:sys-firstdata-api-v1-config"
          doc:name="post:/unlock dispatch">
        <flow-ref name="rf-firstdata-unlock-post" doc:name="rf-firstdata-unlock-post"/>
    </flow>

    <flow name="post:\merchantkeyactivation:application/json:sys-firstdata-api-v1-config"
          doc:name="post:/merchantkeyactivation dispatch">
        <flow-ref name="rf-firstdata-merchantkeyactivation-post" doc:name="rf-firstdata-merchantkeyactivation-post"/>
    </flow>

</mule>
