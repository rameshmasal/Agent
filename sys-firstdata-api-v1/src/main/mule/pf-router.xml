<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
            http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit
            http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/documentation
            http://www.mulesoft.org/schema/mule/documentation/current/mule-documentation.xsd">

    <flow name="pf-router" doc:name="pf-router">
        <apikit:router config-ref="sys-firstdata-api-v1-config" doc:name="APIKit Router" />
        <error-handler ref="global-error" />
    </flow>

    <!-- ── Dispatcher flows — one per RAML operation ─────────────────────
         APIKit resolves the flow by name: {method}:/{resource}:application/json:{config-name}
         Each dispatcher delegates to the Newell-named rf-* flow.
    ──────────────────────────────────────────────────────────────────── -->

    <flow name="post:\balance:application/json:sys-firstdata-api-v1-config"
          doc:name="post:/balance dispatch">
        <flow-ref name="rf-firstdata-balance-post" doc:name="rf-firstdata-balance-post" />
    </flow>

    <flow name="post:\activate:application/json:sys-firstdata-api-v1-config"
          doc:name="post:/activate dispatch">
        <flow-ref name="rf-firstdata-activate-post" doc:name="rf-firstdata-activate-post" />
    </flow>

    <flow name="post:\lock:application/json:sys-firstdata-api-v1-config"
          doc:name="post:/lock dispatch">
        <flow-ref name="rf-firstdata-lock-post" doc:name="rf-firstdata-lock-post" />
    </flow>

    <flow name="post:\unlock:application/json:sys-firstdata-api-v1-config"
          doc:name="post:/unlock dispatch">
        <flow-ref name="rf-firstdata-unlock-post" doc:name="rf-firstdata-unlock-post" />
    </flow>

    <flow name="post:\merchantkeyactivation:application/json:sys-firstdata-api-v1-config"
          doc:name="post:/merchantkeyactivation dispatch">
        <flow-ref name="rf-firstdata-merchantkeyactivation-post" doc:name="rf-firstdata-merchantkeyactivation-post" />
    </flow>

</mule>
