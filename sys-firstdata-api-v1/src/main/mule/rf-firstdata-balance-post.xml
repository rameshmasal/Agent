<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
            http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
            http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core
            http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/documentation
            http://www.mulesoft.org/schema/mule/documentation/current/mule-documentation.xsd">

    <!--
        POST /sys/firstdata/v1/balance
        Request  : { cardNumber, pin, currencyCode, transactionId? }
        Header   : X-Brand: marmot | yankee candle
        Response : { statusCode, returnCode, cardNumber, availableBalance,
                     lockedAmount, previousBalance, currencyCode, ... }
    -->
    <flow name="rf-firstdata-balance-post" doc:name="rf-firstdata-balance-post">

        <logger level="INFO"
            message="#['[rf-firstdata-balance-post] START correlationId=' ++ correlationId]"
            doc:name="Log start" />

        <!-- ── 1. Save original JSON payload before any sub-flow changes it ── -->
        <set-variable variableName="requestPayload" value="#[payload]" doc:name="Save requestPayload" />

        <!-- ── 2. Extract and normalise brand from header ─────────────────── -->
        <set-variable
            variableName="brand"
            value="#[lower(attributes.headers.'X-Brand' default '')]"
            doc:name="Set vars.brand" />

        <!-- ── 3. Validate brand against whitelist ────────────────────────── -->
        <choice doc:name="Validate brand">
            <when expression="#[(p('sys.whitelisted-brands') splitBy ',') contains vars.brand]">
                <logger level="DEBUG" message="#['[rf-firstdata-balance-post] brand valid: ' ++ vars.brand]" doc:name="Log valid brand" />
            </when>
            <otherwise>
                <raise-error type="APP:INVALID_BRAND"
                    description="#['Brand not whitelisted: ' ++ vars.brand]" />
            </otherwise>
        </choice>

        <!-- ── 4. Load brand config (sets vars.brandConfig + vars.brandMerchantKey) ── -->
        <flow-ref name="sf-build-brand-config" doc:name="Build brand config" />

        <!-- ── 5. URL discovery (sets vars.targetUrl) ─────────────────────── -->
        <flow-ref name="sf-url-discovery" doc:name="Discover target URL" />

        <!-- ── 6. PIN handling ────────────────────────────────────────────── -->
        <set-variable variableName="pin" value="#[vars.requestPayload.pin as String]" doc:name="Set vars.pin" />

        <choice doc:name="Encrypt PIN?">
            <when expression="#[vars.brandConfig.merchantKeyId != 'NOKEY']">
                <flow-ref name="sf-encrypt-pin" doc:name="3DES encrypt PIN" />
                <!-- vars.encryptedPin is set by sf-encrypt-pin; payload is now the encrypted PIN string -->
            </when>
            <otherwise>
                <!-- NOKEY: use plain PIN -->
                <set-variable variableName="encryptedPin" value="#[vars.pin]" doc:name="Use plain PIN" />
            </otherwise>
        </choice>

        <!-- ── 7. Build First Data field-delimited payload ────────────────── -->
        <ee:transform doc:name="Build FD balance payload string">
            <ee:variables>
                <ee:set-variable variableName="fdPayload" resource="transformdata/request-to-firstdata-balance.dwl" />
            </ee:variables>
        </ee:transform>

        <!-- ── 8. Build XML request envelope ──────────────────────────────── -->
        <ee:transform doc:name="Build XML request">
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
import floor from dw::core::Math
output application/xml encoding="UTF-8"
---
{
  Request @(Version: p('sys.request-version')): {
    ReqClientID: {
      DID: vars.brandConfig.did,
      App: vars.brandConfig.appId,
      Auth: vars.brandConfig.merchantId ++ "|" ++ vars.brandConfig.tid,
      ClientRef: ((floor(random() * 9000000) + 1000000) as Number as String) ++ p('sys.application-version')
    },
    Transaction: {
      ServiceID: vars.brandConfig.serviceId as Number,
      Payload @(Encoding: p('sys.payload-encoding')): vars.fdPayload
    }
  }
}
                ]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <!-- ── 9. Call First Data ──────────────────────────────────────────── -->
        <logger level="INFO"
            message="#['[rf-firstdata-balance-post] calling FD url=' ++ vars.targetUrl]"
            doc:name="Log FD call" />

        <http:request
            method="POST"
            url="#[vars.targetUrl]"
            config-ref="fdHttpRequestConfig"
            doc:name="POST to First Data">
            <http:headers>
                <http:header key="Content-Type" value="application/xml; charset=utf-8" />
                <http:header key="User-Agent" value="${sys.user-agent}" />
            </http:headers>
            <http:response-validator>
                <http:success-status-code-validator values="200..299" />
            </http:response-validator>
        </http:request>

        <!-- ── 10. Parse XML response → JSON ──────────────────────────────── -->
        <ee:transform doc:name="Parse FD balance response">
            <ee:message>
                <ee:set-payload resource="transformdata/firstdata-to-balance-response.dwl" />
            </ee:message>
        </ee:transform>

        <set-variable variableName="httpStatus" value="#[200]" doc:name="Set HTTP 200" />

        <logger level="INFO"
            message="#['[rf-firstdata-balance-post] DONE returnCode=' ++ (payload.returnCode default 'N/A')]"
            doc:name="Log done" />


    </flow>

</mule>
