<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="60">

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%-5p %d{HH:mm:ss.SSS} [%t] [%X{correlationId}] %c{1} - %m%n" />
        </Console>
        <RollingFile name="RollingFile"
            fileName="${sys:mule.home}/logs/sys-firstdata-api-v1.log"
            filePattern="${sys:mule.home}/logs/sys-firstdata-api-v1-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout>
                <Pattern>%-5p %d{ISO8601} [%t] [%X{correlationId}] %c{1.} - %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <OnStartupTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="25 MB" />
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
            </Policies>
            <DefaultRolloverStrategy max="10" />
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Application flows — INFO for normal operations -->
        <AsyncLogger name="com.newellbrands.sys.firstdata" level="INFO" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
        </AsyncLogger>

        <!-- Mule core — WARN to suppress verbose framework logs -->
        <AsyncLogger name="org.mule" level="WARN" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
        </AsyncLogger>
        <AsyncLogger name="com.mulesoft" level="WARN" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
        </AsyncLogger>

        <!-- HTTP connector — WARN (avoids payload logging in prod) -->
        <AsyncLogger name="org.mule.service.http" level="WARN" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
        </AsyncLogger>

        <!-- Groovy scripting — INFO to see encryption lifecycle -->
        <AsyncLogger name="org.codehaus.groovy" level="INFO" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
        </AsyncLogger>

        <Root level="WARN">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
        </Root>
    </Loggers>

</Configuration>
