<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
    http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- Expects vars.errCode, vars.errStatus, vars.errMessage. Builds vars.app_error and vars.httpStatus; caller then raises APP:ERROR -->
    <sub-flow name="sf-build-app-error">
        <ee:transform doc:name="build-app-error">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="app_error"><![CDATA[%dw 2.0
output application/json
---
{
    "error": {
        "code": vars.errCode,
        "status": vars.errStatus,
        "message": vars.errMessage,
        "correlationId": vars.correlationId default correlationId
    }
}]]></ee:set-variable>
                <ee:set-variable variableName="httpStatus"><![CDATA[%dw 2.0
output application/java
---
vars.errCode as Number]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
    </sub-flow>
</mule>
