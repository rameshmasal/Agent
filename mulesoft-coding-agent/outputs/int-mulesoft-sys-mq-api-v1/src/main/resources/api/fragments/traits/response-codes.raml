#%RAML 1.0 Trait

responses:
  400:
    description: Bad Request - empty body, body is not valid JSON, or invalid queue name.
    body:
      application/json:
        example: !include ../../responses/errors/error-400-response.json
  401:
    description: Unauthorized - invalid or missing client credentials.
    body:
      application/json:
        example: !include ../../responses/errors/error-401-response.json
  404:
    description: Not Found - queue does not exist in Anypoint MQ.
    body:
      application/json:
        example: !include ../../responses/errors/error-404-response.json
  405:
    description: Method Not Allowed.
    body:
      application/json:
        example: !include ../../responses/errors/error-405-response.json
  406:
    description: Not Acceptable.
    body:
      application/json:
        example: !include ../../responses/errors/error-406-response.json
  415:
    description: Unsupported Media Type.
    body:
      application/json:
        example: !include ../../responses/errors/error-415-response.json
  500:
    description: Internal Server Error.
    body:
      application/json:
        example: !include ../../responses/errors/error-500-response.json
  501:
    description: Not Implemented.
    body:
      application/json:
        example: !include ../../responses/errors/error-501-response.json
  502:
    description: Bad Gateway - Anypoint MQ or the token service returned an unexpected response.
    body:
      application/json:
        example: !include ../../responses/errors/error-502-response.json
  503:
    description: Service Unavailable - Anypoint MQ or the token service is unreachable.
    body:
      application/json:
        example: !include ../../responses/errors/error-503-response.json
  504:
    description: Gateway Timeout - Anypoint MQ or the token service timed out.
    body:
      application/json:
        example: !include ../../responses/errors/error-504-response.json
