<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
  xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
  xmlns="http://www.mulesoft.org/schema/mule/core"
  xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
  <munit:config name="prc-product-registration-api-v1-test-suite" />
  <munit:test name="post-product-registration-smoke-test" description="Smoke test for Register a product via SFDC">
    <munit:execution>
      <munit:set-event>
        <munit:payload value="#[readUrl('classpath://examples/post-product-registration-request.json', 'application/json')]" mediaType="application/json" />
      </munit:set-event>
      <flow-ref name="rf-post-product-registration" />
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::notNullValue()]" />
    </munit:validation>
  </munit:test>

  <munit:test name="get-replacement-parts-smoke-test" description="Smoke test for Retrieve replacement parts from SFCC">
    <munit:execution>
      <munit:set-event>
        <munit:payload value="#[readUrl('classpath://examples/get-replacement-parts-request.json', 'application/json')]" mediaType="application/json" />
      </munit:set-event>
      <flow-ref name="rf-get-replacement-parts" />
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::notNullValue()]" />
    </munit:validation>
  </munit:test>
</mule>
