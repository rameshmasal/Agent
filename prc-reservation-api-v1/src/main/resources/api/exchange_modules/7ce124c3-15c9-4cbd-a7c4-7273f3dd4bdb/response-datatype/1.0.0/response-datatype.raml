#%RAML 1.0 DataType

type: object
properties:
  status:
    type: string
    required: true
    description: "Status description"
  status-code:
    type: string
    required: true
    description: "http status code"
    example: "200"
  message:
    type: string
    required: true
    description: "Success Message"
    example: "Success"
  transaction-id:
    type: string
    required: true
    description: "Transaction ID"
    example: dd960082-abbf-47c2-8c65-f18eeb35848b