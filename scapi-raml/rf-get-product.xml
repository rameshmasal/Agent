<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- PRODUCTS / CATEGORIES GET — sets vars → calls rf-scapi-checkout-get-calls -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <flow name="rf-product-get-flow">
        <ee:transform doc:name="set-variables">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="urlPath"><![CDATA[%dw 2.0
output application/java
---
attributes.requestPath]]></ee:set-variable>
                <ee:set-variable variableName="hostname"><![CDATA[Mule::p('scapi.shortCode') ++ '.' ++ Mule::p('scapi.host')]]></ee:set-variable>
                <ee:set-variable variableName="authcode"><![CDATA[%dw 2.0
output application/json
---
attributes.headers.authorization]]></ee:set-variable>
                <ee:set-variable variableName="queryParams"><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <logger level="INFO" doc:name="Logger" message="Product flow GET"/>
        <flow-ref name="rf-scapi-checkout-get-calls" doc:name="rf-scapi-checkout-get-calls"/>
    </flow>

</mule>
